{
  "manifest_version": 3,
  "name": "Tunas: catat domain situs",
  "description": "Mengirim hanya nama domain situs yang sedang aktif ke agen Tunas di laptop ini (127.0.0.1). Tanpa path, judul, atau isi halaman.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "110"
}
