# Compose settings (VPS only)
APP_NAME=tunas
APP_PORT=3002
IMAGE=ghcr.io/ardwiinoo/tunas

# App settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DATABASE_URL=
PUBLIC_BASE_URL=https://tunas.ardwiinoo.my.id
HTTP_ADDR=:8080
TIMEZONE=Asia/Jakarta
BIFROST_BASE_URL=https://gateway.ardwiinoo.my.id/v1
BIFROST_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODELS=
LLM_DAILY_REQUEST_CAP=30
TAVILY_API_KEY=
# Phase 7: worklog. Holiday API (no key); default https://tanggalmerah.upset.dev
HOLIDAY_API_BASE=
# Phase 7: one-way GitHub backup of the worklog. Fine-grained token for ONE
# private repo, Contents read/write. Empty = backup off.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_DIR=
# Phase 8g: VPS statistics file written by scripts/host-stats.sh (cron on the host),
# mounted read-only into the container. Empty = the VPS part of /status is off.
HOST_STATS_FILE=
LOG_LEVEL=info
